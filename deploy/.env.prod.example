WEB_PORT=18088
TZ=Asia/Shanghai
APP_ENV=standalone

APP_IMAGE=ghcr.io/your-github-user/lalalandshow/app
IMAGE_TAG=latest

POSTGRES_DB=lalaland
POSTGRES_USER=lalaland
POSTGRES_PASSWORD=lalaland

JWT_SECRET=standalone-jwt-secret-not-for-production
HMAC_SECRET=standalone-hmac-secret-not-for-production

ADMIN_USERS=admin
ADMIN_PASSWORDS=admin
CHECKER_USER=checker
CHECKER_PASSWORD=checker

RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW=1m
RATE_LIMIT_GENERIC_MAX=300
RATE_LIMIT_BOOKING_MAX=1200

DB_MAX_CONNS=12
DB_MIN_CONNS=1
DB_MAX_CONN_LIFETIME=1h
DB_MAX_CONN_IDLE_TIME=5m

BACKUP_RETENTION_DAYS=14
BACKUP_INTERVAL_SECONDS=86400

RUN_MIGRATIONS=true
SEED_SEATS=true
