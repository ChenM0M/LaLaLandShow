+  const left = Math.max(0, (-panX.value / zoom.value) - wrapper.offsetLeft)
+  const top = Math.max(0, (-panY.value / zoom.value) - wrapper.offsetTop)
+  const width = Math.min(wrapper.scrollWidth, viewport.clientWidth / zoom.value)
