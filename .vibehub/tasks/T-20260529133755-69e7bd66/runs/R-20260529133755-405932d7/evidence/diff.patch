+  zone?: string
+  row_no?: number
+  col_no?: number
+  ticket_version?: number
+  booked_at?: string
+}
+
+export interface Seat {
+  seat_id: number
+  zone: string
+  row_no: number
+  col_no: number
+  is_blocked?: boolean
+  state: 'free' | 'locked' | 'mine' | 'proxy' | 'others'
+  student_id?: string | null
+  booked_by_student_id?: string | null
+}
+
+export interface PublicConfig {
+  play_name?: string
+  venue?: string
+  booking_open_at?: string
+  booking_lock_at?: string
+  show_start_at?: string
+  countdown_target_at?: string
+  show_date?: string
+  cast_list?: string[]
+  gallery_urls?: string[]
+  story_background?: string
+  story_summary?: string
+}
+
+export interface WindowState {
+  state: 'before_open' | 'open' | 'locked' | 'show_started'
+}
+
+export interface LoginResponse {
+  token: string
+  student: Student
+  need_register: boolean
+}
+
+export interface RegisterResponse {
+  student: Student
