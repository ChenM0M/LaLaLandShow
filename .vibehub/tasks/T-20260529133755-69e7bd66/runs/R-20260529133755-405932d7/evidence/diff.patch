+<script setup lang="ts">
+import { computed, onMounted, ref } from 'vue'
+import {
+  adminAuditLogs,
+  adminCheckinEvents,
+  adminDashboard,
+  adminLogin,
+  adminSeats,
+  adminStudents,
+  assignAdminSeat,
