@@ -0,0 +1,24 @@
+#!/usr/bin/env bash
+set -e
+
+echo "======================================"
+echo "✨ Starting La La Land Show Servers ✨"
+echo "======================================"
+
+# Navigate to deploy directory
+cd "$(dirname "$0")/deploy"
+
+# Check if .env exists, if not, copy example
+if [ ! -f .env ] && [ -f .env.example ]; then
+    echo "Creating default .env from .env.example..."
+    cp .env.example .env
+fi
+
+# Build and start all containers in detached mode
+echo "Bringing up containers (Postgres, Redis, Backend)..."
+docker-compose up -d --build
+
+echo ""
+echo "✅ All containers started successfully!"
+echo "📡 Backend API is running at: http://localhost:8080"
+echo "   (Check 'docker-compose logs -f' in the deploy folder if you need to debug)"
