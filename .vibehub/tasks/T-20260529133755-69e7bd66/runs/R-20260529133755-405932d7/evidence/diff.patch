+  border-radius: 8px;
+  overflow: hidden;
+}
+
+.ticket-card-main,
+.ticket-card-bottom {
+  display: grid;
+  grid-template-columns: minmax(0, 1fr) auto;
+  gap: 18px;
+  align-items: center;
+  padding: 24px;
+}
+
+.ticket-card h2,
+.pending-ticket h2,
+.state-title,
+.closed-card h2 {
+  margin: 6px 0 4px;
+  font-family: 'Libre Bodoni', 'Noto Serif TC', serif;
+  font-size: clamp(28px, 5vw, 44px);
+  font-weight: 400;
+  line-height: 1;
+  color: #fff4cf;
+}
+
+.ticket-card p,
+.pending-ticket p,
+.state-panel p,
+.closed-card p {
+  color: rgba(255, 244, 207, 0.74);
+}
+
+.stub-label,
+.state-kicker {
+  display: inline-flex;
+  color: #f4c46f;
+  font-size: 12px;
+  letter-spacing: 0.16em;
+  text-transform: uppercase;
+}
+
+.seat-block {
+  min-width: 150px;
+  padding: 14px 16px;
+  border-left: 1px solid rgba(255, 244, 207, 0.18);
+}
+
+.seat-block span,
+.ticket-details span {
+  display: block;
+  color: rgba(255, 244, 207, 0.52);
+  font-size: 12px;
+  letter-spacing: 0.12em;
+  text-transform: uppercase;
+}
+
+.seat-block strong {
+  display: block;
+  margin-top: 4px;
+  color: #fff4cf;
+  font-size: 20px;
+}
+
+.ticket-cut {
+  height: 1px;
+  margin: 0 18px;
+  background: repeating-linear-gradient(90deg, rgba(255, 244, 207, 0.4) 0 8px, transparent 8px 17px);
+}
+
+.ticket-details {
+  display: grid;
+  gap: 12px;
+}
+
+.ticket-details p {
+  margin: 0;
+  overflow-wrap: anywhere;
+}
+
+.qr-box {
+  width: 214px;
+  height: 214px;
+  display: grid;
+  place-items: center;
+  padding: 12px;
+  border-radius: 6px;
+  background: #fff;
+}
+
+.qr-box :deep(svg) {
+  width: 190px;
+  height: 190px;
+  display: block;
+}
+
+.qr-private {
+  width: 214px;
+  min-height: 214px;
+  display: grid;
+  align-content: center;
+  gap: 10px;
+  padding: 18px;
+  border-radius: 6px;
+  border: 1px dashed rgba(255, 244, 207, 0.28);
+  background: rgba(255, 244, 207, 0.06);
+  text-align: center;
+}
+
+.qr-private span {
+  color: #f4c46f;
+  font-size: 13px;
+  letter-spacing: 0.12em;
+}
+
+.qr-private p {
+  margin: 0;
+  font-size: 14px;
+  color: rgba(255, 244, 207, 0.64);
+}
+
+.state-panel,
+.closed-card {
+  width: min(560px, 100%);
+  min-height: 260px;
+  display: grid;
+  align-content: center;
+  gap: 18px;
+  padding: 34px;
+  border-radius: 8px;
+}
+
+.closed-stage {
+  min-height: 420px;
+  display: grid;
+  place-items: center;
+  background: rgba(0, 0, 0, 0.42);
+  filter: grayscale(0.1);
+  border-radius: 8px;
+}
+
+.closed-card {
+  text-align: center;
+  background: rgba(10, 12, 20, 0.78);
+}
+
+.pending-ticket {
+  position: relative;
+  padding: 24px;
+  border-radius: 8px;
+  overflow: hidden;
+}
+
+.pending-ticket::after {
+  content: '';
+  position: absolute;
+  inset: 0;
+  background: linear-gradient(135deg, transparent, rgba(255, 244, 207, 0.08));
+  pointer-events: none;
+}
+
+.pending-ticket small,
+.muted-text {
+  color: rgba(255, 244, 207, 0.56);
+}
+
+.manage-link {
+  position: relative;
+  z-index: 1;
+  width: max-content;
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  min-height: 38px;
+  margin-top: 16px;
+  padding: 0 14px;
+  border: 1px solid rgba(255, 244, 207, 0.22);
+  border-radius: 999px;
+  color: #fff4cf;
+  background: rgba(255, 244, 207, 0.06);
+  text-decoration: none;
+  font-size: 13px;
+  letter-spacing: 0.04em;
+}
+
+.manage-link:hover {
+  border-color: rgba(255, 214, 107, 0.5);
+  background: rgba(255, 214, 107, 0.12);
+}
+
+.manage-link.compact {
+  justify-self: center;
+  margin-top: 4px;
+}
+
+@media (max-width: 680px) {
+  .ticket-page {
+    padding: 22px 12px 100px;
+  }
+
+  .ticket-backdrop {
+    background:
+      linear-gradient(180deg, rgba(3, 9, 33, 0.64), rgba(3, 9, 33, 0.9)),
+      url('/assets/images/lalaland-clean-hero-mobile.jpg') center top / cover;
+  }
+
+  .ticket-card-main,
+  .ticket-card-bottom {
+    grid-template-columns: 1fr;
+    padding: 20px;
+  }
+
+  .seat-block {
+    min-width: 0;
+    border-left: 0;
+    border-top: 1px solid rgba(255, 244, 207, 0.18);
+    padding: 14px 0 0;
+  }
+
+  .qr-box {
+    width: min(100%, 246px);
+    height: auto;
+    aspect-ratio: 1;
+    justify-self: center;
+  }
+
+  .qr-private {
+    width: min(100%, 246px);
+    min-height: 168px;
+    justify-self: center;
+  }
+
+  .state-panel,
+  .closed-card {
+    padding: 26px 20px;
+  }
+}
+</style>
