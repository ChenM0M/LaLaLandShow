+:root {
+  --bg: #141050;
+  --surface: #21135c;
+  --gold: #f6b23f;
+  --gold-light: #ffd66b;
+  --purple: #6556ff;
+  --purple-light: #b06cff;
+  --pink: #ff4f91;
+  --cyan: #27d7df;
+  --wine: #5e1739;
+  --cream: #fff3d7;
+  --muted: rgba(255, 243, 215, 0.68);
+  --border: rgba(255, 243, 215, 0.16);
+  --border-hover: rgba(255, 214, 107, 0.45);
+  --surface-glass: rgba(21, 16, 80, 0.76);
+  --grad-accent: linear-gradient(135deg, #ffd66b, #ff4f91 48%, #6556ff);
+  --shadow-glow: 0 24px 80px rgba(22, 11, 65, 0.42);
+  --radius-sm: 2px;
+  --radius-md: 4px;
+  --radius-lg: 8px;
+}
+
+*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
+
+html { 
+  scroll-behavior: smooth;
+}
+
+/* Hide scrollbar completely for cinematic feel */
+::-webkit-scrollbar { width: 0; height: 0; display: none; }
+body { -ms-overflow-style: none; scrollbar-width: none; }
+
+::selection {
+  background: var(--gold);
+  color: #000;
+}
+
+body {
+  background:
+    radial-gradient(circle at 14% 0%, rgba(255, 214, 107, 0.22), transparent 26rem),
+    radial-gradient(circle at 88% 16%, rgba(255, 79, 145, 0.17), transparent 24rem),
+    linear-gradient(180deg, #18105c 0%, #21104c 48%, #2a112d 100%);
+  color: var(--cream);
+  font-family: 'Nunito Sans', 'Noto Serif TC', -apple-system, BlinkMacSystemFont, sans-serif;
+  font-size: clamp(14px, 1.5vw, 18px);
+  line-height: 1.7;
+  -webkit-font-smoothing: antialiased;
+  -moz-osx-font-smoothing: grayscale;
+  transition: background-color 2s ease;
+  overflow-x: hidden;
+}
+
+/* Film Grain Overlay */
+.film-grain {
+  position: fixed;
+  top: 0; left: 0;
+  width: 100vw; height: 100vh;
+  pointer-events: none;
+  z-index: 9999;
+  opacity: 0.04;
+  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.8' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E");
