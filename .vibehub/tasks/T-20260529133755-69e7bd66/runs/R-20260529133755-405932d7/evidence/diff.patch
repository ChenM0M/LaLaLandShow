+}
+
+.btn-outline {
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  padding: clamp(12px, 2vw, 16px) clamp(24px, 4vw, 40px);
+  background: transparent;
+  color: var(--cream);
+  border: 1px solid rgba(255, 255, 255, 0.2);
+  border-radius: 0;
+  font-family: 'Inter', sans-serif;
+  font-size: clamp(11px, 1.5vw, 14px);
+  font-weight: 500;
+  letter-spacing: 0.15em;
+  text-transform: uppercase;
+  text-decoration: none;
+  transition: all 400ms ease;
+}
+.btn-outline:hover {
+  border-color: var(--cream);
+  background: rgba(255, 255, 255, 0.05);
+}
+
+/* Animations */
+.fade-up {
+  opacity: 0;
+  transform: translateY(30px);
+  transition: opacity 1.5s cubic-bezier(0.16, 1, 0.3, 1), transform 1.5s cubic-bezier(0.16, 1, 0.3, 1);
+}
+.fade-up.visible {
+  opacity: 1;
+  transform: translateY(0);
+}
+
+/* Form elements */
+input, select {
+  background: transparent;
+  border: none;
+  border-bottom: 1px solid rgba(255,255,255,0.2);
+  color: var(--cream);
+  padding: 12px 0;
+  border-radius: 0;
+  font-family: 'Inter', sans-serif;
+  font-size: 16px;
+  width: 100%;
+  outline: none;
+  transition: border-color 400ms ease;
+}
+
+textarea {
+  width: 100%;
+  min-height: 140px;
+  background: rgba(255,255,255,0.04);
+  color: var(--cream);
+  border: 1px solid var(--border);
+  border-radius: var(--radius-md);
+  padding: 12px;
+  font: inherit;
+  outline: none;
+  resize: vertical;
+}
+textarea:focus { border-color: var(--gold); }
+input:focus, select:focus {
+  border-color: var(--gold);
+}
+input::placeholder {
+  color: rgba(255,255,255,0.3);
+}
+
+label {
+  display: block;
+  margin-bottom: 8px;
+  font-size: 12px;
+  color: var(--muted);
+  text-transform: uppercase;
+  letter-spacing: 0.15em;
+}
+
+.form-group { margin-bottom: 32px; }
+
+.error-msg {
+  color: #ef4444;
+  font-size: 13px;
+  margin-top: 8px;
+}
+
+.page-center {
+  min-height: calc(100vh - 80px);
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  padding: clamp(20px, 4vw, 40px);
+}
+
+.page-shell {
+  max-width: 1200px;
+  margin: 0 auto;
+  padding: 32px 24px 120px; /* Leave room for bottom dock */
+}
+
+.card {
+  background: var(--surface-glass);
+  border: none;
+  box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.05), var(--shadow-glow);
+  border-radius: var(--radius-lg);
+  padding: 24px;
+  backdrop-filter: blur(16px);
+  -webkit-backdrop-filter: blur(16px);
+}
+
+.panel-grid {
+  display: grid;
+  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
+  gap: 16px;
+}
+
+.metric {
+  background: linear-gradient(145deg, rgba(255, 255, 255, 0.06), rgba(255, 255, 255, 0.02));
+  border: none;
+  box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.04);
+  border-radius: var(--radius-md);
+  padding: 18px;
+}
+.metric-value {
+  display: block;
+  font-size: 32px;
+  line-height: 1;
+  margin-top: 8px;
+  color: var(--gold-light);
+}
+
+.toolbar {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 10px;
+  align-items: center;
+  margin: 18px 0;
+}
+
+.tabs {
+  display: flex;
+  gap: 8px;
+  flex-wrap: wrap;
+  margin: 20px 0;
+}
+.tab-btn {
+  border: 1px solid var(--border);
+  background: rgba(255,255,255,0.04);
+  color: var(--muted);
+  padding: 9px 14px;
+  border-radius: var(--radius-md);
+}
+.tab-btn.active {
+  color: #000;
+  background: var(--gold-light);
+  border-color: var(--gold-light);
+}
+
+.table-wrap {
+  overflow-x: auto;
+  border: none;
+  box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.05);
+  border-radius: var(--radius-lg);
+  background: rgba(0, 0, 0, 0.1);
+}
+table {
+  width: 100%;
+  min-width: 720px;
+  border-collapse: collapse;
+}
+th, td {
+  padding: 14px 12px;
+  border-bottom: 1px solid rgba(255, 255, 255, 0.05);
+  text-align: left;
+  vertical-align: top;
+  font-size: 14px;
+}
+tbody tr {
+  transition: background 0.2s ease;
+}
+tbody tr:hover {
+  background: rgba(255, 255, 255, 0.03);
+}
+th {
+  color: var(--muted);
+  text-transform: uppercase;
+  letter-spacing: 0.08em;
+  font-size: 11px;
+}
+tr:last-child td { border-bottom: 0; }
+
+.status-pill {
+  display: inline-flex;
+  align-items: center;
+  gap: 6px;
+  border: 1px solid var(--border);
+  border-radius: 999px;
+  padding: 5px 10px;
+  font-size: 12px;
+  color: var(--muted);
+}
+.status-pill.good { color: #86efac; border-color: rgba(134,239,172,0.35); }
+.status-pill.warn { color: #fde68a; border-color: rgba(253,230,138,0.35); }
+.status-pill.bad { color: #fca5a5; border-color: rgba(252,165,165,0.35); }
+
+.split {
+  display: grid;
+  grid-template-columns: minmax(0, 1fr) minmax(280px, 420px);
+  gap: 20px;
+}
+
+.muted { color: var(--muted); }
+.stack { display: grid; gap: 16px; }
+.actions { display: flex; flex-wrap: wrap; gap: 10px; }
+
+@media (max-width: 860px) {
+  .split { grid-template-columns: 1fr; }
+  .page-shell { padding: 24px 16px 100px; }
+}
+
+/* Glassmorphism Utilities */
+.glass-panel {
+  background: rgba(21, 16, 80, 0.55);
+  backdrop-filter: blur(24px);
+  -webkit-backdrop-filter: blur(24px);
+  box-shadow: 0 -10px 40px rgba(0, 0, 0, 0.3), inset 0 1px 0 rgba(255, 255, 255, 0.1);
+}
+
+/* Page transitions */
+.page-enter-active, .page-leave-active {
+  transition: opacity 800ms ease, transform 800ms ease;
+}
+.page-enter-from, .page-leave-to {
+  opacity: 0;
+}
