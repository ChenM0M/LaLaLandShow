+            <div v-for="event in dashboard?.recent.checkin_events || []" :key="event.id" style="padding:10px 0;border-bottom:1px solid var(--border)">
+              <span class="status-pill" :class="event.is_first_scan ? 'good' : 'warn'">{{ event.method }}</span>
