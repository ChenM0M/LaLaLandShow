+      zone,
+      label: zoneLabels[zone] ?? zone,
+      count: Array.from(byZone.get(zone)!.values()).reduce((sum, row) => sum + row.length, 0),
+      rows: Array.from(byZone.get(zone)!.entries())
+        .sort(([a], [b]) => a - b)
+        .map(([row, rowSeats]) => ({
